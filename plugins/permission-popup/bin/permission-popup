#!/bin/sh
# PermissionRequest hook entry. Exiting 0 with no output leaves the decision to Claude Code's own prompt.
[ "$(uname)" = Darwin ] || exit 0
root=$(cd "$(dirname "$0")/.." && pwd)
app="$root/PermissionPopup.app/Contents/MacOS/permission-popup"

# A copy without the prebuilt app builds it once from source, which needs the Xcode command line tools.
if [ ! -x "$app" ]; then
    command -v swiftc >/dev/null 2>&1 || exit 0
    # Parallel sessions may race here; the loser leaves its request to Claude Code's prompt.
    mkdir "$root/.build-lock" 2>/dev/null || exit 0
    "$root/build.sh" >&2
    status=$?
    rmdir "$root/.build-lock"
    [ "$status" -eq 0 ] || exit 0
fi
exec "$app"
