{
  "description": "Card with Allow/Deny for Claude Code permission prompts (macOS)",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/permission-popup\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
